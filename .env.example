# Docker Compose reads this file after copying to .env.
# Set these as process environment variables when running Spring Boot directly.
DB_URL=jdbc:postgresql://localhost:5432/tho_xay_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Supply a Base64-encoded random key (32+ bytes), or use scripts/start-local.ps1.
JWT_SECRET=
# Optional FCM server configuration. Never put a service account in the repository or APK.
APP_FCM_ENABLED=false
APP_FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional wallet warning threshold in whole Vietnamese dong.
APP_WALLET_MINIMUM_ESCROW=200000
# Cloud: use SPRING_PROFILES_ACTIVE=prod and set the real DB_URL (JDBC), credentials,
# JWT_SECRET and exact HTTPS CORS_ORIGINS in the Backend hosting dashboard.
# Vercel needs only API_BASE_URL=https://YOUR-BACKEND (without /api).
# Full setup: docs/DEPLOY_VERCEL.md. Do not commit cloud credentials.
