{
  "folders": [
    {
      "name": "01. HỒ SƠ BẢO VỆ & DEMO",
      "path": "00_BAO_VE_DO_AN"
    },
    {
      "name": "02. BACKEND & WEB ADMIN (Spring Boot)",
      "path": "src/main"
    },
    {
      "name": "03. MOBILE & WEB APP (Flutter)",
      "path": "mobile_app/lib"
    },
    {
      "name": "04. CƠ SỞ DỮ LIỆU (PostgreSQL)",
      "path": "migrations"
    },
    {
      "name": "05. TRIỂN KHAI CLOUD (Render & Vercel)",
      "path": "cloud_deploy"
    },
    {
      "name": "06. KIỂM THỬ TỰ ĐỘNG (Tests)",
      "path": "kiem_thu"
    }
  ],
  "settings": {
    "explorer.compactFolders": false,
    "explorer.excludeGitIgnore": false,
    "workbench.editor.labelFormat": "medium",
    "terminal.integrated.cwd": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/..",
    "files.exclude": {
      "**/.agents": true,
      "**/.aider-desk": true,
      "**/.local": true,
      "**/.mvn": true,
      "**/.tools": true,
      "**/.vercel": true,
      "**/target": true,
      "**/.dockerignore": true,
      "**/.flutter-version": true,
      "**/.gitattributes": true,
      "**/.vercelignore": true,
      "**/skills-lock.json": true,
      "**/mvnw": true,
      "**/mvnw.cmd": true,
      "**/.vscode": true,
      "**/.dart_tool": true,
      "**/build": true,
      "**/node_modules": true,
      "**/__pycache__": true
    }
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Bảo vệ: đồng bộ bản tham chiếu",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/../scripts/prepare-defense-workspace.ps1"
        ],
        "options": {
          "cwd": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/.."
        },
        "problemMatcher": []
      },
      {
        "label": "Bảo vệ: kiểm thử và build Backend",
        "type": "shell",
        "command": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/../mvnw.cmd",
        "args": ["-B", "verify"],
        "options": {
          "cwd": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/.."
        },
        "problemMatcher": [],
        "group": "test"
      },
      {
        "label": "Bảo vệ: kiểm thử Flutter",
        "type": "shell",
        "command": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/../.tools/flutter/bin/flutter.bat",
        "args": ["test"],
        "options": {
          "cwd": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/../mobile_app"
        },
        "problemMatcher": [],
        "group": "test"
      },
      {
        "label": "Bảo vệ: khởi động demo đã build",
        "type": "process",
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/../scripts/start-demo.ps1",
          "-SkipBuild"
        ],
        "options": {
          "cwd": "${workspaceFolder:01. HỒ SƠ BẢO VỆ & DEMO}/.."
        },
        "problemMatcher": []
      }
    ]
  }
}
